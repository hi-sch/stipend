# Sandbox key from https://docs.lithic.com/docs/get-api-key
# Never prefix with VITE_ — the browser must not see this value.
LITHIC_API_KEY=
LITHIC_ENV=sandbox

# First-run logins. If unset, random passwords are generated and printed once in the server log.
STIPEND_ADMIN_PASSWORD=
STIPEND_CARDHOLDER_PASSWORD=

# Email alerts. Any nodemailer SMTP URL, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Stipend <no-reply@example.com>
# Public URL of this app: hook and Lithic URLs, email links. Admin → Settings can override it.
PUBLIC_URL=

# Logging: json (default) or pretty; level debug|info|warn|error.
LOG_FORMAT=json
LOG_LEVEL=info

# Optional Lithic secrets (whsec_…). The admin console fetches and stores them when you enroll.
LITHIC_WEBHOOK_SECRET=
LITHIC_ASA_SECRET=
LITHIC_3DS_SECRET=
LITHIC_TOKENIZATION_SECRET=

# Optional. Physical card product id. Sandbox uses 100.
LITHIC_PRODUCT_ID=100
# Optional. Google Pay web push integrator id from Lithic / Google.
LITHIC_GOOGLE_INTEGRATOR_ID=
# Optional. Defaults to Lithic's documented Apple web-push partner id.
LITHIC_APPLE_PARTNER_ID=

# Optional. Bind address and port for `npm run dev` / `npm start`. Defaults to 127.0.0.1:5175.
HOST=
PORT=
# Optional. Set to 1 behind HTTPS so the session cookie is marked Secure.
STIPEND_SECURE_COOKIES=
# Optional. Set to 1 when a proxy or ingress sits in front, so the client address is read
# from the right-hand end of X-Forwarded-For. Without it every request behind a proxy looks
# like it came from the proxy, and sign-in rate limiting cannot tell one client from
# another. Leave it unset when nothing proxies: the header is then whatever the caller
# typed, and trusting it would let anyone forge an address.
STIPEND_TRUST_PROXY=

# Database. Postgres connection string, e.g. postgres://user:pass@host:5432/stipend
# In Kubernetes this comes from the CloudNativePG cluster secret, not from this file.
DATABASE_URL=
# Optional. Pool size per process. Keep replicas * DATABASE_POOL_MAX under the server's
# max_connections.
DATABASE_POOL_MAX=10

# Encrypts the secrets Stipend stores: connection HMAC secrets, and the ASA, webhook, 3DS
# and tokenization secrets from Lithic. Without it those are kept in clear, so a database
# dump is a full key compromise.
#
# Any passphrase of 16 characters or more; the key is derived from it. Losing it means
# losing every stored secret, so keep it where you keep LITHIC_API_KEY. Setting it later
# is safe: values already in the database keep working and are encrypted when next written.
#
# Every process sharing a database must use the same key. A replica started without it, or
# with a different one, cannot read the secrets the others wrote.
STIPEND_SECRET_KEY=

# Two-operator approval for sensitive writes (cash rules, recalls, cardholder deletion,
# external payments, settings). Set to 1 to switch it on.
# Leave it off for a program with a single operator: a request cannot be approved by the
# operator who made it, so with one account those changes could never be carried out.
STIPEND_REQUIRE_APPROVAL=

# Operator single sign-on (OIDC). Cardholders keep local passwords; operators federate.
# Leave OIDC_ISSUER empty to keep password sign-in for operators too.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional. Defaults to <public URL>/api/auth/oidc/callback.
OIDC_REDIRECT_URI=
# Optional. Extra scopes beyond `openid email profile`.
OIDC_SCOPES=
# Optional. Claim that carries group membership, and the group that grants operator access.
# Without OIDC_ADMIN_GROUP every successfully authenticated user is treated as an operator.
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=
